# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# emulator-only E2E server build (playwright.config.ts)
/.next-e2e/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# firebase
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
*-debug.log

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# PWA — generated by @serwist/next's webpack plugin from src/app/sw.ts at build time
/public/sw.js
/public/sw.js.map
/public/swe-worker-*.js
/public/swe-worker-*.js.map

# firebase credentials & emulator data — never commit
*service-account*.json
*serviceAccount*.json
*firebase-adminsdk*.json
emulator-data/
firebase-export-*/

# local Claude Code runtime files
.claude/scheduled_tasks.lock
.claude/settings.local.json
