# ELORA JEWELLERY — environment variables
# Copy to .env.local and fill in real values. Never commit real secrets.

# --- Firebase client SDK (safe to expose to the browser; identifies the
# project only, does not authorize anything) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Set to "true" to point the client SDK at the Firebase Local Emulator Suite
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# --- Firebase Admin SDK (server-only — NEVER exposed to the client) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Admin bootstrap (scripts/create-admin.ts, Phase 2) ---
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# --- Guest cart cookie signing (Phase 6, research.md §5) — required in
# production; a random 32+ byte value, e.g. `openssl rand -hex 32` ---
CART_COOKIE_SECRET=

# --- Social config (Phase 13) — pending real values from the store owner;
# every consumer fails safe (hidden/disabled) while these are unset.
# Quote any value containing spaces, e.g. MESSAGE_EN="Hello ELORA!" ---
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_WHATSAPP_PHONE=
NEXT_PUBLIC_WHATSAPP_DEFAULT_MESSAGE_EN=
NEXT_PUBLIC_WHATSAPP_DEFAULT_MESSAGE_AR=

# --- Footer TikTok link (Phase 4, spec FR-006) — pending a real URL from
# the store owner; the Footer hides this link entirely while unset ---
NEXT_PUBLIC_TIKTOK_URL=
